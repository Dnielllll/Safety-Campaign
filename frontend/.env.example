# ── Supabase (direct client — used for auth, realtime, CRUD) ─────────────────
VITE_SUPABASE_URL=https://zuuwqrxmkeryzbcrlrai.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Microservices API Gateway (replaces VITE_API_URL) ────────────────────────
# All /api/* requests are routed through this Nginx gateway to the correct service:
#   /api/auth/*          → auth-service       (Laravel, port 8001)
#   /api/campaigns/*     → campaign-service   (Laravel, port 8002)
#   /api/contents/*      → content-service    (Laravel, port 8003)
#   /api/workflow/*      → workflow-service   (Laravel, port 8004)
#   /api/notifications/* → notification-service (Node.js, port 3001)
VITE_API_GATEWAY_URL=http://localhost:8080

# Legacy — kept for backward compatibility during migration
# VITE_API_URL=http://localhost:8080/api

